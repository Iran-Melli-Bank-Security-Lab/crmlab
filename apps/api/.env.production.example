NODE_ENV=production
HOST=0.0.0.0
PORT=4000

CLIENT_URL=http://10.10.10.122
CLIENT_URLS=http://10.10.10.122
SOCKET_ALLOWED_ORIGINS=http://10.10.10.122

MONGO_URI=mongodb://127.0.0.1:27017/test
LEGACY_DATABASE_NAME=test
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters
CSRF_SECRET=replace-with-at-least-32-random-characters
CREDENTIAL_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# This deployment uses plain HTTP on a private IP and same-origin cookies.
# Switch COOKIE_SECURE=true when TLS is enabled.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
TRUST_PROXY_HOPS=1

# Optional. Defaults to <PM2 user home>/crmlab-uploads.
UPLOAD_DIR=
